# Local: npm run dev (Node.js 24). Docker: docker compose --profile warp up -d --build
PORT=3100
MANAGER_USER=admin
# Required by Docker. Set a long unique password before starting.
MANAGER_PASSWORD=
# Local default: http://localhost:3100. VPS: https://manager.your-domain.example
PUBLIC_URL=http://localhost:3100
# Local development: SOCKS5 address exposed by the optional WARP container.
WARP_PROXY_URL=socks5://127.0.0.1:40000
# Optional API overrides for an existing self-hosted Nuvio account backend.
# NUVIO_API_URL=https://api.nuvio.tv
# NUVIO_ANON_KEY=
# NUVIO_LOGIN_URL=https://nuvio.tv/tv-login
